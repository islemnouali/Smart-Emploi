{
  "name": "smart_emploi",
  "version": "1.0.1",
  "description": "Smart Emploi",
  "license": "ISC",
  "author": "islem nouali",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/islemnouali/Smart-Emploi"
  },
  "dependencies": {
    "electron-store": "^10.0.1",
    "electron-updater": "^6.3.9",
    "intro.js": "^7.2.0"
  },
  "devDependencies": {
    "electron": "^34.0.2",
    "electron-builder": "^25.1.8"
  },
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "publish": "electron-builder --publish always"
  },
  "build": {
    "appId": "com.islem.smart_emploi",
    "productName": "Smart Emploi",
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "src/Assets/logo1.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "islemnouali",
        "repo": "Smart-Emploi",
        "releaseType": "release"
      }
    ]
  }
}
